# Server
PORT=

# Required in production (Vercel)
JWT_SECRET=
# Turso / libSQL (required on Vercel — local SQLite file won't persist)
# Create a DB at https://turso.tech then paste:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional: Vercel Blob for student photos (recommended on Vercel)
# BLOB_READ_WRITE_TOKEN=

# Local only (optional). If unset, uses file:./data/ecole.db
# TURSO_DATABASE_URL=file:./data/ecole.db
